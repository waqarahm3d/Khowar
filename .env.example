# Pakistani Music App Environment Configuration

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=postgresql://username:password@localhost:5432/pakistani_music_app

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# JWT CONFIGURATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-for-pakistani-music-app-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# ==============================================
# CLOUD STORAGE CONFIGURATION
# ==============================================

# Default storage provider (aws, wasabi, backblaze, gdrive)
DEFAULT_STORAGE_PROVIDER=aws

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pakistani-music-app

# Wasabi Configuration (S3 Compatible)
WASABI_ACCESS_KEY_ID=your-wasabi-access-key-id
WASABI_SECRET_ACCESS_KEY=your-wasabi-secret-access-key
WASABI_REGION=us-east-1
WASABI_BUCKET=pakistani-music-app
WASABI_ENDPOINT=https://s3.wasabisys.com

# Backblaze B2 Configuration
BACKBLAZE_KEY_ID=your-backblaze-key-id
BACKBLAZE_APPLICATION_KEY=your-backblaze-application-key
BACKBLAZE_BUCKET_ID=your-backblaze-bucket-id
BACKBLAZE_BUCKET_NAME=pakistani-music-app

# Google Drive Configuration
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Google Cloud Storage (if using GCS instead of Drive)
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_KEY_FILE=./path/to/service-account-key.json
GOOGLE_CLOUD_BUCKET=pakistani-music-app

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@qoqnuz.com

# ==============================================
# PAKISTANI CULTURAL CONFIGURATION
# ==============================================
DEFAULT_LANGUAGE=urdu
DEFAULT_THEME=pakistan-green

# ==============================================
# ANALYTICS CONFIGURATION
# ==============================================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_SOCIAL_LOGIN=true
FEATURE_OFFLINE_MODE=true
FEATURE_CULTURAL_THEMES=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_PREMIUM=false

# ==============================================
# EXTERNAL API CONFIGURATION
# ==============================================

# Last.fm API (for music metadata)
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_SECRET=your-lastfm-secret

# Spotify API (for music discovery)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# MusicBrainz API (for music metadata)
MUSICBRAINZ_USER_AGENT=PakistaniMusicApp/1.0.0

# ==============================================
# PAYMENT CONFIGURATION (if premium features enabled)
# ==============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal Configuration (for Pakistani market)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# JazzCash/EasyPaisa Configuration (Pakistani payment methods)
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_RETURN_URL=http://localhost:3000/payment/jazzcash/callback

EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_STORE_PASSWORD=your-easypaisa-store-password

# ==============================================
# SOCIAL LOGIN CONFIGURATION
# ==============================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ==============================================
# PUSH NOTIFICATION CONFIGURATION
# ==============================================
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.qoqnuz.pakistani-music-app

# ==============================================
# MONITORING AND ERROR TRACKING
# ==============================================
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-32-character-encryption-key
SESSION_SECRET=your-session-secret-key

# ==============================================
# CULTURAL EVENTS CONFIGURATION
# ==============================================
ENABLE_CULTURAL_EVENTS=true
ENABLE_FESTIVAL_THEMES=true
ENABLE_REGIONAL_CONTENT=true

# ==============================================
# DEVELOPMENT CONFIGURATION
# ==============================================
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=true

# ==============================================
# PRODUCTION CONFIGURATION
# ==============================================
# Uncomment and configure for production
# ENABLE_HTTPS=true
# SSL_CERT_PATH=./ssl/cert.pem
# SSL_KEY_PATH=./ssl/key.pem
# TRUST_PROXY=true
# SECURE_COOKIES=true